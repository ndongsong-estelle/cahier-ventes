<?xml version="1.0" encoding="utf-8"?>
<!-- Flavor dev uniquement : HTTP en clair autorisé (ex. http://192.168.1.20:8000/api). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
